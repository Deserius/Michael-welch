# ---------------------------------------------------------------------------
# Da RoastBox! — environment template
# Copy to .env and fill in. `.env` is gitignored — never commit real keys.
# ---------------------------------------------------------------------------

# --- Supabase (required) ---------------------------------------------------
# Browser-side values. Safe to expose: RLS restricts what the anon key can do.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Server-side values, read by the /api functions only.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # NEVER expose this

# --- AI providers (optional) ----------------------------------------------
# Without these the app still works: it falls back to the built-in local
# comedy engine, and to browser speech synthesis for voices.
OPENAI_API_KEY=
ELEVENLABS_API_KEY=

# --- Stripe (optional) ----------------------------------------------------
# Without STRIPE_API_KEY, credit purchases run in demo mode and grant
# instantly (the API returns "stripe": false so the UI can say so).
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Admin (optional) -----------------------------------------------------
# Comma-separated user ids or emails allowed to set the APP-WIDE provider
# keys via /api/global-keys. If unset, the oldest account is treated as owner.
ADMIN_USER_IDS=

# --- Google OAuth (optional) ----------------------------------------------
VITE_GOOGLE_CLIENT_ID=
VITE_GOOGLE_AUTH_PROXY=
