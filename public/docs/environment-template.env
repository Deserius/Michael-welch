# ---------------------------------------------------------------------------
# Da RoastBox! — environment template
# Copy to .env and fill in. `.env` is gitignored — never commit real keys.
# ---------------------------------------------------------------------------

# --- Supabase (required) ---------------------------------------------------
# Browser-side values. Safe to expose: RLS restricts what the anon key can do.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Server-side values, read by the /api functions only.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # NEVER expose this

# --- AI providers (optional) ----------------------------------------------
# Without these the app still works: it falls back to the built-in local
# comedy engine, and to browser speech synthesis for voices.
OPENAI_API_KEY=
ELEVENLABS_API_KEY=

# --- Stripe (optional) ----------------------------------------------------
# Without STRIPE_API_KEY, credit purchases run in demo mode and grant
# instantly (the API returns "stripe": false so the UI can say so).
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Admin (optional) -----------------------------------------------------
# Comma-separated user ids or emails allowed to set the APP-WIDE provider
# keys via /api/global-keys. If unset, the oldest account is treated as owner.
ADMIN_USER_IDS=

# --- Google OAuth (optional) ----------------------------------------------
VITE_GOOGLE_CLIENT_ID=
VITE_GOOGLE_AUTH_PROXY=

# ---------------------------------------------------------------------------
# AI providers (all optional — without them roast text falls back to the local
# engine, and speech is skipped)
# ---------------------------------------------------------------------------
# OpenRouter: preferred for roast text. One key reaches many models.
# https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Direct OpenAI: used for text if OpenRouter is absent, and for TTS.
OPENAI_API_KEY=
# ElevenLabs: premium speech. Charged as an add-on.
ELEVENLABS_API_KEY=

# ---------------------------------------------------------------------------
# Google sign-in (optional). Create an OAuth 2.0 Web client at
# https://console.cloud.google.com/apis/credentials and add
# <site>/auth-complete.html to the authorised redirect URIs.
# ---------------------------------------------------------------------------
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Used to build absolute redirect URLs in OAuth flows.
PUBLIC_SITE_URL=http://localhost:5173

# ---------------------------------------------------------------------------
# Stripe (optional). Test-mode keys (sk_test_...) are detected automatically.
# ---------------------------------------------------------------------------
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=
